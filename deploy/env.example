# Скопировать в /etc/kinolog-site.env и заполнить. Файл не публиковать.
PORT=3000
HOST=127.0.0.1
DATA_FILE=/var/lib/kinolog-site/db.json
CONFIG_FILE=/var/lib/kinolog-site/config.json
# Ключ шифрования ключей банков в базе. Сгенерировать: openssl rand -hex 32. Потерять нельзя, иначе введённые ключи банков придётся вводить заново.
SECRET=
# Стартовый пароль админки (после первого входа смените его в админке).
ADMIN_PASSWORD=
# Тестовый режим оплаты выключается в админке, раздел «Оплата».
