[Unit]
Description=Artyushkin site
After=network.target

[Service]
Type=simple
User=site
WorkingDirectory=/opt/kinolog-site
EnvironmentFile=/etc/kinolog-site.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/kinolog-site

[Install]
WantedBy=multi-user.target
